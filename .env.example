# TMDB credentials – provide ONE of them (https://www.themoviedb.org/settings/api).
# The token/key stays on the server; the browser only talks to our own /api routes.
# Without any of them the app falls back to built-in mock data so it runs out of the box.

# v4 "API Read Access Token" (preferred)
TMDB_API_TOKEN=
# v3 "API Key"
TMDB_API_KEY=

# Optional
TMDB_LANGUAGE=en-US
PORT=5173
